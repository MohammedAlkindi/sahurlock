# ── Spotify Integration (optional) ────────────────────────────────────────────
#
# Create a Spotify app at https://developer.spotify.com/dashboard
#
# Required settings in your Spotify app:
#   Redirect URI → http://localhost:3000/api/spotify/callback
#
# Copy this file to .env.local and fill in the values.

# Login uses PKCE, so only the client ID is needed. Do not add a client secret.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: override the redirect URI (defaults to <request-origin>/api/spotify/callback)
# SPOTIFY_REDIRECT_URI=https://your-domain.example/api/spotify/callback
